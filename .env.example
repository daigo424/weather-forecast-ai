DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# ローカル CLI 用 (make train など、Docker 外で実行する場合)
MLFLOW_TRACKING_URI=sqlite:///data/mlflow.db

# Docker コンテナのバックエンド切り替え（DagsHub 使用時のみ設定）
# 未設定時は各コンテナがローカル SQLite ファイルを直接使用
# MLFLOW_REMOTE_TRACKING_URI=https://dagshub.com/{username}/{repo}.mlflow
# MLFLOW_TRACKING_USERNAME={dagshub_username}
# MLFLOW_TRACKING_PASSWORD={dagshub_token}

LGBM_N_JOBS=-1
