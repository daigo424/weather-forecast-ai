ENV=local

# ----------------------------------------------------------------
# S3 バケット — 設定時は 01_raw / 02_processed を s3://{bucket}/ 配下に読み書き
# 未設定時はプロジェクトルート/data/ をローカルで使用（docker-compose はこちら）
# make s3-upload-raw / s3-download-raw でも使用
# 本番では IAM Role を使用するため AWS_ACCESS_KEY_ID 等は不要
# ----------------------------------------------------------------
# S3_ML_DATA_BUCKET=your-bucket-name

# ----------------------------------------------------------------
# Airflow — JWT 署名キー（SHA512 HMAC には 64 バイト以上必要）
# 生成例: python -c "import secrets; print(secrets.token_hex(64))"
# ----------------------------------------------------------------
AIRFLOW_SECRET_KEY=

# ----------------------------------------------------------------
# DB — Docker Compose と Python 共通の設定
# Docker Compose 内のサービス間通信はホスト名 "db" 固定（env var 不要）
# Python がローカルから接続する場合は DB_HOST=localhost
# ----------------------------------------------------------------
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5432
DB_SSLMODE=disable
MLFLOW_DB_NAME=mlflow
AIRFLOW_DB_NAME=airflow
FEAST_DB_NAME=feast

# ----------------------------------------------------------------
# Redis — Feast オンラインストア（誤差ラグ特徴量の低レイテンシ取得に使用）
# Docker Compose 内ではコンテナ側で REDIS_HOST=redis に上書き済み（変更不要）
# EKS では ElastiCache のエンドポイントを設定（クラスターモードは DB 番号不可）
# ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------------
# MLflow
# ----------------------------------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# DagsHub 使用時のみ設定
# MLFLOW_TRACKING_URI=https://dagshub.com/{username}/{repo}.mlflow
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=

# ----------------------------------------------------------------
# LightGBM
# ----------------------------------------------------------------
LGBM_N_JOBS=-1

# ----------------------------------------------------------------
# Open-Meteo 商用プラン API キー（未設定時は無料エンドポイントを使用）
# ----------------------------------------------------------------
OPEN_METEO_API_KEY=
