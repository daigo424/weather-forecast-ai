        { "id": "pair_sync_future",   "name": "forecast_days", "value": "0" },
        { "id": "pair_sync_hourly",   "name": "hourly",        "value": "temperature_2m,relative_humidity_2m,dew_point_2m,pressure_msl,surface_pressure,cloud_cover,cloud_cover_low,cloud_cover_mid,cloud_cover_high,precipitation,rain,weather_code,wind_speed_10m,wind_direction_10m,wind_gusts_10m" },
